{
  "name": "@trust-medical/feedback-reporter",
  "version": "4.4.1",
  "private": true,
  "description": "Feedback reporter SDK with manual image uploads, an isolated Web Component, and diagnostic context",
  "keywords": [
    "laravel",
    "feedback",
    "bug-report",
    "screenshot",
    "web-component",
    "alpinejs"
  ],
  "homepage": "https://github.com/trust-medical/laravel-feedback-reporter#readme",
  "bugs": {
    "url": "https://github.com/trust-medical/laravel-feedback-reporter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trust-medical/laravel-feedback-reporter.git"
  },
  "author": "Trust Medical <fukuhara@trust-medical.jp>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./alpine": {
      "types": "./dist/alpine.d.ts",
      "import": "./dist/alpine.js"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/widget.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check resources/js tests-js",
    "format": "biome format --write resources/js tests-js",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "konva": "^10.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "happy-dom": "^20.14.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "vite": "^6.4.3",
    "@vitest/mocker": "^4.1.11"
  },
  "peerDependencies": {
    "alpinejs": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "alpinejs": {
      "optional": true
    }
  }
}
